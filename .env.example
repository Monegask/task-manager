# Скопируй этот файл в .env и подставь реальные значения.
# .env гитнорится — никогда не коммить.
#
# Где взять:
#   1. Создай проект на https://supabase.com (бесплатный tier)
#   2. Project Settings → API → Project URL и Project API keys → anon / public
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
